# Copy to .env (never commit .env). All values below are placeholders.

# PostgreSQL connection (Neon / Supabase / Vercel Postgres in production).
# Local dev: `npm run db:dev` starts an embedded Postgres matching this URL.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/goldenwings

# Long random string, signs login sessions. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Public URL of the site, read at runtime (CSRF/CORS allow-list, links in emails).
# On Vercel set it to the custom domain, e.g. https://goldenwingsjo.com; Vercel's own deployment URLs are trusted automatically.
SERVER_URL=http://localhost:3000

# Persistent image storage. Required in production (Vercel's filesystem is not persistent).
# Vercel dashboard > Storage > Blob > create store > copy the read/write token.
BLOB_READ_WRITE_TOKEN=

# Optional: SMTP for password-reset emails and booking notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@goldenwingsjo.com
# Optional: who receives an email for each new booking request
BOOKING_NOTIFY_EMAIL=
