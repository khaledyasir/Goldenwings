# Copy to .env (never commit .env). All values below are placeholders.
# On the server see docs/DEPLOY_WINDOWS.md.

# PostgreSQL connection. On the server: the local PostgreSQL database created during setup.
# Local development: `npm run db:dev` starts an embedded Postgres matching this URL.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/goldenwings

# Long random string that signs login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Public address of the site, e.g. https://goldenwingsjo.com (used for login security and links in emails)
SERVER_URL=http://localhost:3000

# Development machines only: sync the database schema automatically. Never set this on the server.
# PAYLOAD_PUSH=true

# Port the Node app listens on (only IIS on the same machine talks to it)
PORT=3000

# Folder for uploaded images. Keep it OUTSIDE the app folder on the server so updates never touch it,
# e.g. D:\goldenwings-data\media. Defaults to ./media
MEDIA_DIR=

# Optional: SMTP for password-reset emails and booking notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@goldenwingsjo.com
# Optional: who receives an email for each new booking request
BOOKING_NOTIFY_EMAIL=
