<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS front for the Golden Wings Node app (docs/DEPLOY_WINDOWS.md, step 6).
  Copy this file into the IIS site's folder (e.g. C:\inetpub\goldenwings). IIS only forwards requests:
  the app itself runs as the "GoldenWings" Windows service on 127.0.0.1:3000.
  Requires the IIS "URL Rewrite" and "Application Request Routing" modules.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Let's Encrypt (win-acme / Plesk) validation files are served from this folder, over plain HTTP -->
        <rule name="ACME challenge" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/" />
          <action type="None" />
        </rule>
        <!-- Everything over HTTPS (skipped for http://localhost so the site can be checked on the server itself) -->
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
            <add input="{HTTP_HOST}" pattern="^localhost(:\d+)?$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- Forward to the Node app; it needs to know the visitor came in over HTTPS -->
        <rule name="Golden Wings app" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <!-- Image uploads up to 10 MB (plus form overhead); Next.js URLs may contain encoded characters -->
      <requestFiltering allowDoubleEscaping="true">
        <requestLimits maxAllowedContentLength="20971520" />
      </requestFiltering>
    </security>
    <!-- Show the app's own error pages instead of IIS ones -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
